<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Curso"
        tools:targetApi="31">
        <activity
            android:name=".PantillasUnidades.UnidadVideoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />
        <activity
            android:name=".PantillasUnidades.UnidadIntroActivity"
            android:exported="false" />
        <activity
            android:name=".Administracion"
            android:exported="false" />
        <activity
            android:name=".LoginP"
            android:exported="false" />
        <activity
            android:name=".unidades.agradecimientos"
            android:exported="false" />
        <activity
            android:name=".Generarcertificado"
            android:exported="false" />
        <activity
            android:name=".PantillasUnidades.ParcialActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


        <activity
            android:name=".unidades.unidades"
            android:exported="false" />
        <activity
            android:name=".usuarios.Registro"
            android:exported="false" />
        <activity
            android:name=".usuarios.Login"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:fitsSystemWindows="true"/>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>