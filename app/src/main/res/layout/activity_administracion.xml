<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/blue">


    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginVertical="20dp"
            android:background="@drawable/login_stile"
            android:hint="Título de la unidad"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/etConceptos"
            android:hint="Conceptos (separados por coma)"
            android:background="@drawable/login_stile"
            android:layout_marginVertical="20dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/etVideo"
            android:hint="URL del video"
            android:background="@drawable/login_stile"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:textColor="#000000" />


        <TextView
            android:text="Evaluación:"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:layout_marginVertical="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnAgregarPregunta"
            android:text="Agregar Pregunta"
            android:backgroundTint="@color/white"
            android:textColor="@color/blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPreguntas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnCrear"
                android:text="Crear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:textColor="@color/blue"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnEditar"
                android:text="Editar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:textColor="@color/blue"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnEliminar"
                android:text="Eliminar"
                android:backgroundTint="@color/white"
                android:textColor="@color/blue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
