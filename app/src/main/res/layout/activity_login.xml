<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/blue"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".usuarios.Login"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">





        <LinearLayout
            android:id="@+id/toggleContainer"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:background="@drawable/toggle_background"
            android:padding="5dp"
            android:elevation="4dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnUsuario"
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/blue"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Usuario"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <Space
                android:layout_width="5dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnAdmin"
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:backgroundTint="@color/blue"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Admins"
                android:textAllCaps="false"
                android:textColor="#444"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="95dp"
            android:text="Iniciar Sesión"
            android:textColor="@color/white"
            android:textSize="30sp" />


        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="50dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/login_stile"
            android:drawableStart="@android:drawable/sym_action_email"
            android:drawablePadding="15dp"
            android:drawableTint="@color/blue"
            android:ems="10"
            android:hint="pablogt1234@gmail.com"
            android:inputType="textEmailAddress"
            android:padding="10dp"
            android:textColor="@color/black"
            android:textColorHint="@color/blue" />

        <EditText
            android:id="@+id/passwordEditText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="50dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/login_stile"
            android:drawableStart="@android:drawable/ic_lock_idle_lock"
            android:drawablePadding="15dp"
            android:drawableTint="@color/blue"
            android:ems="10"
            android:hint="• • • • • • • • • • • •"
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="@color/black"
            android:textColorHint="@color/blue" />

        <Button
            android:id="@+id/iniciar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginHorizontal="50dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#FFF"
            android:text="Iniciar"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/Recupera"
            android:layout_width="340dp"
            android:layout_height="55dp"
            android:layout_marginHorizontal="65dp"
            android:layout_marginTop="50dp"
            android:clickable="true"
            android:focusable="true"
            android:text="¡Recupera tu contraseña!"
            android:textColor="#F44336"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvRegistrarse"
            android:layout_width="250dp"
            android:layout_height="59dp"
            android:layout_marginHorizontal="100dp"
            android:layout_marginTop="30dp"
            android:clickable="true"
            android:focusable="true"
            android:text="¡Registrate Ahora!"
            android:textColor="#F44336"
            android:textSize="22sp" />

    </LinearLayout>

</ScrollView>