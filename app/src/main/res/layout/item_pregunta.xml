<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/login_stile"
    android:padding="12dp"
    android:layout_margin="8dp">

    <EditText
        android:id="@+id/etPregunta"
        android:hint="Texto de la pregunta"
        android:background="@drawable/login_stile"
        android:layout_marginVertical="10dp"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:textColor="#000000" />

    <EditText
        android:id="@+id/etOpcion1"
        android:hint="Opción 1"
        android:background="@drawable/login_stile"
        android:layout_marginVertical="10dp"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:textColor="#000000" />

    <EditText
        android:id="@+id/etOpcion2"
        android:hint="Opción 2"
        android:background="@drawable/login_stile"
        android:layout_marginVertical="10dp"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:textColor="#000000" />

    <EditText
        android:id="@+id/etOpcion3"
        android:hint="Opción 3"
        android:background="@drawable/login_stile"
        android:layout_marginVertical="10dp"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:textColor="#000000" />

    <EditText
        android:id="@+id/etOpcion4"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginVertical="10dp"
        android:background="@drawable/login_stile"
        android:hint="Opción 4"
        android:textColor="#000000" />

    <Spinner
        android:id="@+id/spCorrecta"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginVertical="10dp"
        android:prompt="@string/respuesta_correcta"
        android:textColor="#000000" />

    <ImageButton
        android:id="@+id/btnEliminarPregunta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:src="@android:drawable/ic_delete"
        android:background="@drawable/login_stile"
        android:contentDescription="Eliminar pregunta" />

</LinearLayout>